generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Comment {
  id                Int               @id @default(autoincrement())
  postId            String            @db.VarChar(32)
  userId            Int
  parentCommentId   Int?
  content           String            @db.Text
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  parent            Comment?          @relation("commentTocomment", fields: [parentCommentId], references: [id], map: "Comment_parentCommentId_fkey")
  replies           Comment[]         @relation("commentTocomment")
  post              Post              @relation(fields: [postId], references: [id], map: "Comment_postId_fkey")
  user              User              @relation(fields: [userId], references: [id], map: "Comment_userId_fkey")
  reactions         CommentReaction[]
  notifications     Notification[]
  notificationBatch NotificationBatch[]

  @@index([parentCommentId], map: "Comment_parentCommentId_fkey")
  @@index([postId], map: "Comment_postId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model CommentReaction {
  id        Int                      @id @default(autoincrement())
  userId    Int
  commentId Int
  reaction  commentreaction_reaction
  createdAt DateTime                 @default(now())
  comment   Comment                  @relation(fields: [commentId], references: [id], onDelete: Cascade, map: "CommentReaction_commentId_fkey")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CommentReaction_userId_fkey")

  @@unique([userId, commentId], map: "CommentReaction_userId_commentId_key")
  @@index([commentId], map: "CommentReaction_commentId_idx")
  @@index([commentId, reaction], map: "CommentReaction_commentId_reaction_idx")
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  type         String                    @default("direct")
  name         String?
  createdBy    Int
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime
  lastMessageAt DateTime?
  isArchived   Boolean                   @default(false)
  participants ConversationParticipant[]
  messages     Message[]
  notifications Notification[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  role           String       @default("member")
  conversation   Conversation @relation(fields: [conversationId], references: [id], map: "ConversationParticipant_conversationId_fkey")
  user           User         @relation(fields: [userId], references: [id], map: "ConversationParticipant_userId_fkey")

  @@unique([conversationId, userId], map: "ConversationParticipant_conversationId_userId_key")
  @@index([userId], map: "ConversationParticipant_userId_fkey")
}

model Follow {
  id          Int            @id @default(autoincrement())
  followerId  Int
  followingId Int
  status      String         @default("accepted")
  createdAt   DateTime       @default(now())
  follower    User           @relation("follow_followerIdTouser", fields: [followerId], references: [id], map: "Follow_followerId_fkey")
  following   User           @relation("follow_followingIdTouser", fields: [followingId], references: [id], map: "Follow_followingId_fkey")
  notifications Notification[]

  @@unique([followerId, followingId], map: "Follow_followerId_followingId_key")
  @@index([followingId], map: "Follow_followingId_fkey")
}

model Hashtag {
  id           Int           @id @default(autoincrement())
  name         String        @unique(map: "Hashtag_name_key") @db.VarChar(100)
  createdAt    DateTime      @default(now())
  usageCount   Int           @default(0)
  isActive     Boolean       @default(true)
  postHashtags PostHashtag[]

  @@index([name], map: "Hashtag_name_idx")
  @@index([usageCount], map: "Hashtag_usageCount_idx")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    String   @db.VarChar(32)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], map: "Like_postId_fkey")
  user      User     @relation(fields: [userId], references: [id], map: "Like_userId_fkey")

  @@unique([userId, postId], map: "Like_userId_postId_key")
  @@index([postId], map: "Like_postId_fkey")
}

model Message {
  id                 Int           @id @default(autoincrement())
  conversationId     Int
  senderId           Int
  content            String
  messageType        message_messageType @default(TEXT)
  mediaUrl           String?
  repliedToMessageId Int?
  deliveryStatus     String        @default("delivered")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  isDeleted          Boolean       @default(false)
  conversation       Conversation  @relation(fields: [conversationId], references: [id], map: "Message_conversationId_fkey")
  message            Message?      @relation("messageTomessage", fields: [repliedToMessageId], references: [id], map: "Message_repliedToMessageId_fkey")
  other_message      Message[]     @relation("messageTomessage")
  user               User          @relation(fields: [senderId], references: [id], map: "Message_senderId_fkey")
  notifications      Notification[]

  @@index([conversationId], map: "Message_conversationId_fkey")
  @@index([repliedToMessageId], map: "Message_repliedToMessageId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model Notification {
  id                                  Int                 @id @default(autoincrement())
  type                                notification_type
  status                              notification_status @default(UNREAD)
  title                               String?             @db.VarChar(100)
  content                             String              @db.VarChar(500)
  recipientId                         Int
  senderId                            Int?
  postId                              String?             @db.VarChar(32)
  commentId                           Int?
  conversationId                      Int?
  messageId                           Int?
  followId                            Int?
  storyId                             Int?
  metadata                            Json?
  createdAt                           DateTime            @default(now())
  readAt                              DateTime?
  archivedAt                          DateTime?
  expiresAt                           DateTime?
  isDeleted                           Boolean             @default(false)
  userId                              Int?
  comment                             Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade, map: "Notification_commentId_fkey")
  conversation                        Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "Notification_conversationId_fkey")
  follow                              Follow?             @relation(fields: [followId], references: [id], onDelete: Cascade, map: "Notification_followId_fkey")
  message                             Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "Notification_messageId_fkey")
  post                                Post?               @relation(fields: [postId], references: [id], onDelete: Cascade, map: "Notification_postId_fkey")
  user_notification_recipientIdTouser User                @relation("notification_recipientIdTouser", fields: [recipientId], references: [id], onDelete: Cascade, map: "Notification_recipientId_fkey")
  user_notification_senderIdTouser    User?               @relation("notification_senderIdTouser", fields: [senderId], references: [id], map: "Notification_senderId_fkey")
  story                               Story?              @relation(fields: [storyId], references: [id], onDelete: Cascade, map: "Notification_storyId_fkey")
  user_notification_userIdTouser      User?               @relation("notification_userIdTouser", fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([commentId], map: "Notification_commentId_fkey")
  @@index([conversationId], map: "Notification_conversationId_fkey")
  @@index([createdAt], map: "Notification_createdAt_idx")
  @@index([expiresAt], map: "Notification_expiresAt_idx")
  @@index([followId], map: "Notification_followId_fkey")
  @@index([messageId], map: "Notification_messageId_fkey")
  @@index([postId], map: "Notification_postId_idx")
  @@index([recipientId, status, createdAt(sort: Desc)], map: "Notification_recipientId_status_createdAt_idx")
  @@index([recipientId, status], map: "Notification_recipientId_status_idx")
  @@index([recipientId, type, status], map: "Notification_recipientId_type_status_idx")
  @@index([senderId], map: "Notification_senderId_idx")
  @@index([storyId], map: "Notification_storyId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model NotificationBatch {
  id             Int                    @id @default(autoincrement())
  type           notificationbatch_type
  senderId       Int?
  title          String?                @db.VarChar(100)
  content        String                 @db.VarChar(500)
  metadata       Json?
  postId         String?                @db.VarChar(32)
  commentId      Int?
  storyId        Int?
  recipientCount Int                    @default(0)
  sentCount      Int                    @default(0)
  failedCount    Int                    @default(0)
  status         String                 @default("pending")
  createdAt      DateTime               @default(now())
  processedAt    DateTime?
  completedAt    DateTime?
  comment        Comment?               @relation(fields: [commentId], references: [id], onDelete: Cascade, map: "NotificationBatch_commentId_fkey")
  post           Post?                  @relation(fields: [postId], references: [id], onDelete: Cascade, map: "NotificationBatch_postId_fkey")
  user           User?                  @relation(fields: [senderId], references: [id], map: "NotificationBatch_senderId_fkey")
  story          Story?                 @relation(fields: [storyId], references: [id], onDelete: Cascade, map: "NotificationBatch_storyId_fkey")

  @@index([commentId], map: "NotificationBatch_commentId_fkey")
  @@index([postId], map: "NotificationBatch_postId_fkey")
  @@index([senderId], map: "NotificationBatch_senderId_fkey")
  @@index([status, createdAt], map: "NotificationBatch_status_createdAt_idx")
  @@index([storyId], map: "NotificationBatch_storyId_fkey")
  @@index([type, createdAt], map: "NotificationBatch_type_createdAt_idx")
}

model NotificationPreference {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique(map: "NotificationPreference_userId_key")
  emailOnLike       Boolean  @default(false)
  emailOnComment    Boolean  @default(true)
  emailOnFollow     Boolean  @default(true)
  emailOnMessage    Boolean  @default(true)
  emailOnMention    Boolean  @default(true)
  emailDigest       Boolean  @default(true)
  pushOnLike        Boolean  @default(true)
  pushOnComment     Boolean  @default(true)
  pushOnFollow      Boolean  @default(true)
  pushOnMessage     Boolean  @default(true)
  pushOnMention     Boolean  @default(true)
  pushOnStoryView   Boolean  @default(false)
  inAppOnLike       Boolean  @default(true)
  inAppOnComment    Boolean  @default(true)
  inAppOnFollow     Boolean  @default(true)
  inAppOnMessage    Boolean  @default(true)
  inAppOnMention    Boolean  @default(true)
  inAppOnShare      Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String?
  quietHoursEnd     String?
  timezone          String?  @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "NotificationPreference_userId_fkey")
}

model Post {
  id                String              @id @db.VarChar(32)
  userId            Int
  contentType       post_contentType
  caption           String?             @db.VarChar(2000)
  thumbnailUrl      String?             @db.VarChar(500)
  location          String?             @db.VarChar(100)
  taggedUsers       String?
  privacyLevel      post_privacyLevel   @default(PUBLIC)
  allowsComments    Boolean             @default(true)
  allowsShares      Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  expiresAt         DateTime?
  isDeleted         Boolean             @default(false)
  comments          Comment[]
  likes             Like[]
  notifications     Notification[]
  notificationBatch NotificationBatch[]
  user              User                @relation(fields: [userId], references: [id], map: "Post_userId_fkey")
  hashtags          PostHashtag[]
  images            PostImage[]
  postReactions     PostReaction[]
  savedPosts        SavedPost[]
  shares            Share[]

  @@index([userId], map: "Post_userId_fkey")
}

model PostHashtag {
  id        Int      @id @default(autoincrement())
  postId    String   @db.VarChar(32)
  hashtagId Int
  createdAt DateTime @default(now())
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], map: "PostHashtag_hashtagId_fkey")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, map: "PostHashtag_postId_fkey")

  @@unique([postId, hashtagId], map: "PostHashtag_postId_hashtagId_key")
  @@index([hashtagId], map: "PostHashtag_hashtagId_idx")
  @@index([postId], map: "PostHashtag_postId_idx")
}

model PostImage {
  id           Int      @id @default(autoincrement())
  postId       String   @db.VarChar(32)
  imageUrl     String   @db.VarChar(500)
  altText      String?  @db.VarChar(200)
  displayOrder Int      @default(0)
  width        Int?
  height       Int?
  fileSize     Int?
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade, map: "PostImage_postId_fkey")

  @@index([postId, displayOrder], map: "PostImage_postId_displayOrder_idx")
  @@index([postId], map: "PostImage_postId_idx")
}

model PostReaction {
  id        Int                   @id @default(autoincrement())
  userId    Int
  postId    String                @db.VarChar(32)
  reaction  postreaction_reaction
  createdAt DateTime              @default(now())
  post      Post                  @relation(fields: [postId], references: [id], onDelete: Cascade, map: "PostReaction_postId_fkey")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PostReaction_userId_fkey")

  @@unique([userId, postId], map: "PostReaction_userId_postId_key")
  @@index([postId], map: "PostReaction_postId_idx")
  @@index([postId, reaction], map: "PostReaction_postId_reaction_idx")
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    String   @db.VarChar(32)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], map: "SavedPost_postId_fkey")
  user      User     @relation(fields: [userId], references: [id], map: "SavedPost_userId_fkey")

  @@unique([userId, postId], map: "SavedPost_userId_postId_key")
  @@index([postId], map: "SavedPost_postId_fkey")
  @@index([userId], map: "SavedPost_userId_idx")
}

model Share {
  id           Int                @id @default(autoincrement())
  userId       Int
  postId       String             @db.VarChar(32)
  caption      String?
  createdAt    DateTime           @default(now())
  privacyLevel share_privacyLevel @default(PUBLIC)
  post         Post               @relation(fields: [postId], references: [id], map: "Share_postId_fkey")
  user         User               @relation(fields: [userId], references: [id], map: "Share_userId_fkey")

  @@unique([userId, postId], map: "Share_userId_postId_key")
  @@index([postId], map: "Share_postId_fkey")
}

model Story {
  id                Int                 @id @default(autoincrement())
  userId            Int
  mediaUrl          String
  caption           String?
  location          String?
  backgroundColor   String?
  createdAt         DateTime            @default(now())
  expiresAt         DateTime
  viewCount         Int                 @default(0)
  allowsReplies     Boolean             @default(true)
  notifications     Notification[]
  notificationBatch NotificationBatch[]
  user              User                @relation(fields: [userId], references: [id], map: "Story_userId_fkey")

  @@index([userId], map: "Story_userId_fkey")
}

model SystemLogs {
  id         String           @id
  timestamp  DateTime         @default(now())
  level      systemlogs_level
  source     String           @db.VarChar(100)
  message    String           @db.Text
  context    Json?
  userId     Int?
  sessionId  String?          @db.VarChar(255)
  requestId  String?          @db.VarChar(64)
  ipAddress  String?          @db.VarChar(45)
  userAgent  String?          @db.Text
  stackTrace String?          @db.Text
  user       User?            @relation(fields: [userId], references: [id], map: "SystemLogs_userId_fkey")

  @@index([level], map: "SystemLogs_level_idx")
  @@index([requestId], map: "SystemLogs_requestId_idx")
  @@index([sessionId], map: "SystemLogs_sessionId_idx")
  @@index([source], map: "SystemLogs_source_idx")
  @@index([timestamp], map: "SystemLogs_timestamp_idx")
  @@index([userId], map: "SystemLogs_userId_idx")
}

model User {
  id                                          Int                       @id @default(autoincrement())
  username                                    String                    @unique(map: "User_username_key")
  email                                       String                    @unique(map: "User_email_key")
  passwordHash                                String
  phone                                       String?
  accountType                                 user_accountType          @default(PERSONAL)
  privacySettings                             user_privacySettings      @default(PUBLIC)
  verificationStatus                          Boolean                   @default(false)
  createdAt                                   DateTime                  @default(now())
  updatedAt                                   DateTime
  lastActiveAt                                DateTime?
  isActive                                    Boolean                   @default(true)
  isDeleted                                   Boolean                   @default(false)
  comments                                    Comment[]
  commentReactions                            CommentReaction[]
  conversationParticipants                    ConversationParticipant[]
  following                                   Follow[]                  @relation("follow_followerIdTouser")
  followers                                   Follow[]                  @relation("follow_followingIdTouser")
  likes                                       Like[]
  messages                                    Message[]
  notification_notification_recipientIdTouser Notification[]            @relation("notification_recipientIdTouser")
  notification_notification_senderIdTouser    Notification[]            @relation("notification_senderIdTouser")
  notification_notification_userIdTouser      Notification[]            @relation("notification_userIdTouser")
  notificationBatches                         NotificationBatch[]
  notificationPreference                      NotificationPreference?
  posts                                       Post[]
  postReactions                               PostReaction[]
  savedPosts                                  SavedPost[]
  shares                                      Share[]
  stories                                     Story[]
  systemLogs                                  SystemLogs[]
  userInfo                                    UserInfo?
  userSessions                                UserSession[]
}

model UserInfo {
  id                Int              @id @default(autoincrement())
  userId            Int              @unique(map: "UserInfo_userId_key")
  firstName         String?
  middleName        String?
  lastName          String?
  displayName       String?
  bio               String?
  profilePictureUrl String?
  coverPhotoUrl     String?
  birthDate         DateTime?
  gender            userinfo_gender?
  location          String?
  user              User             @relation(fields: [userId], references: [id], map: "UserInfo_userId_fkey")
}

model UserSession {
  id                   Int       @id @default(autoincrement())
  userId               Int
  deviceInfo           String?
  ipAddress            String?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  refreshToken         String    @unique(map: "UserSession_refreshToken_key") @db.VarChar(255)
  previousRefreshToken String?   @db.VarChar(255)
  rotatedAt            DateTime?
  updatedAt            DateTime?
  user                 User      @relation(fields: [userId], references: [id], map: "UserSession_userId_fkey")

  @@index([previousRefreshToken], map: "UserSession_previousRefreshToken_idx")
  @@index([userId], map: "UserSession_userId_fkey")
}

enum notification_type {
  LIKE
  COMMENT
  FOLLOW
  SHARE
  MENTION
  STORY_VIEW
  MESSAGE
  SYSTEM
}

enum notificationbatch_type {
  LIKE
  COMMENT
  FOLLOW
  SHARE
  MENTION
  STORY_VIEW
  MESSAGE
  SYSTEM
}

enum notification_status {
  UNREAD
  READ
  ARCHIVED
  DISMISSED
}

enum post_contentType {
  TEXT
  IMAGE
  VIDEO
  MIXED
}

enum systemlogs_level {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum commentreaction_reaction {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum postreaction_reaction {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum message_messageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum share_privacyLevel {
  PUBLIC
  PRIVATE
  FRIENDS
}

enum user_accountType {
  PERSONAL
  BUSINESS
  CREATOR
}

enum user_privacySettings {
  PUBLIC
  PRIVATE
  FRIENDS
}

enum post_privacyLevel {
  PUBLIC
  PRIVATE
  FRIENDS
}

enum userinfo_gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}
